{
  "name": "ovito-resale-simulator",
  "version": "1.0.0",
  "private": true,
  "description": "Ovito: Resale Simulator mobile app",
  "scripts": {
    "build": "node -e \"require('fs').mkdirSync('www',{recursive:true}); require('child_process').execSync('rsync -a --exclude=.git --exclude=node_modules --exclude=android --exclude=www ./ www/',{stdio:'inherit'})\"",
    "android:sync": "npm run build && cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/core": "^7.4.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3"
  }
}
